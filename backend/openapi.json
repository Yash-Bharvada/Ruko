          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source",
            "description": "Input source (ocr | stt | text | video)"
          },
          "input_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Source",
            "description": "Normalized input source: text | ocr | stt | video",
            "default": "text"
          },
          "speech_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
