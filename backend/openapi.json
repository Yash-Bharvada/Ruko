{
  "openapi": "3.1.0",
  "info": {
    "title": "Ruko Backend",
    "description": "Multilingual investor-protection API for suspicious investment tips",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "description": "Liveness check and module readiness status.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/check": {
      "post": {
        "tags": [
          "Analysis"
        ],
        "summary": "Check Text",
        "description": "Analyze suspicious investment message text and return an explainable verdict.",
        "operationId": "check_text_v1_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/registry/lookup": {
      "get": {
        "tags": [
          "Registry & Info"
        ],
        "summary": "Registry Lookup",
        "description": "Offline dated SEBI intermediary snapshot lookup.\n\nHONEST DISCLOSURE:\n- Queries a dated, local offline snapshot, not live SEBI systems.\n- If not found, status is 'not_found_in_snapshot' ('could not confirm in our snapshot'), never 'fake'.",
        "operationId": "registry_lookup_v1_registry_lookup_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Registration number or entity name to look up",
              "title": "Q"
            },
            "description": "Registration number or entity name to look up"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Registry Lookup V1 Registry Lookup Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/speak": {
      "post": {
        "tags": [
          "Registry & Info"
        ],
        "summary": "Speak Verdict",
        "description": "Read verdict aloud in the user's language.\n\nSECURITY & INTEGRITY:\n- Speaks ONLY safe templated sentences from verified i18n files.\n- Rejects any free-text fields with HTTP 422.\n- Falls back to browser Web Speech API payload on any provider failure or timeout.",
        "operationId": "speak_verdict_v1_speak_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeakRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Speak Verdict V1 Speak Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/privacy": {
      "get": {
        "tags": [
          "Registry & Info"
        ],
        "summary": "Get Privacy",
        "description": "Retrieve privacy policies, data retention guarantees, and third-party AI processor disclosures.\n\nRuko guarantees zero persistence of user content and never logs message bodies.",
        "operationId": "get_privacy_v1_privacy_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Privacy V1 Privacy Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/check/image": {
      "post": {
        "tags": [
          "Media Ingest"
        ],
        "summary": "Check Image",
        "description": "Ingest an image/screenshot, extract text via vision OCR in-memory, and return full CheckResult.",
        "operationId": "check_image_v1_check_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_check_image_v1_check_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/check/audio": {
      "post": {
        "tags": [
          "Media Ingest"
        ],
        "summary": "Check Audio",
        "description": "Ingest an audio voice note, transcribe text via Sarvam STT in-memory, and return full CheckResult.",
        "operationId": "check_audio_v1_check_audio_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_check_audio_v1_check_audio_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/check/media": {
      "post": {
        "tags": [
          "Media Ingest"
        ],
        "summary": "Check Media",
        "description": "Unified multimodal ingestion endpoint: sniffs magic bytes and routes to text, OCR, STT, or video pipeline.",
        "operationId": "check_media_v1_check_media_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_check_media_v1_check_media_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pause/plan": {
      "post": {
        "tags": [
          "Pause & Recovery"
        ],
        "summary": "Create Pause Plan",
        "description": "Generate a cooling-off pause plan before money moves.\n\nFeatures:\n- 3 localized decision reflection questions.\n- 24-hour cooling-off calendar reminder (.ics text + data URI).\n- WhatsApp family share link.\n- Pure arithmetic of loss vs monthly living expenses.",
        "operationId": "create_pause_plan_v1_pause_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PausePlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PausePlan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/resources/already-paid": {
      "get": {
        "tags": [
          "Pause & Recovery"
        ],
        "summary": "Get Recovery Resources",
        "description": "Retrieve verified recovery checklist for users who already paid money to a scam.\n\nIncludes National Cyber Crime Helpline (1930), Cybercrime portal, and SEBI SCORES portal.",
        "operationId": "get_recovery_resources_v1_resources_already_paid_get",
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Language code (en, hi, gu)",
              "default": "en",
              "title": "Lang"
            },
            "description": "Language code (en, hi, gu)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Get Recovery Resources V1 Resources Already Paid Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
