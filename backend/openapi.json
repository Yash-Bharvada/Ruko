        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique machine-readable reason code"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "high | medium | low | info"
          },
          "text": {
            "type": "string",
            "title": "Text",
