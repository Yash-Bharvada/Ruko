        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "description": "Raw suspicious message text"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Optional language hint (gu, hi, en, etc.)"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount",
            "description": "Optional investment amount mentioned"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CheckRequest",
        "description": "Incoming request to check investment text."
      },
      "CheckResult": {
        "properties": {
          "request_id": {
            "type": "string",
