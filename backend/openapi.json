          "code",
          "severity",
          "text",
          "evidence",
          "source"
        ],
        "title": "Reason",
        "description": "Detailed reason for a red flag or finding."
      },
      "RegistryInfo": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "found_in_snapshot | possible_match | not_found_in_snapshot | not_checked"
          },
          "matches": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Matches",
            "description": "Matching records from snapshot"
          },
          "snapshot_date": {
            "type": "string",
            "title": "Snapshot Date",
            "description": "Date of local registry snapshot",
            "default": "2026-03-01"
          },
          "is_sample_data": {
            "type": "boolean",
            "title": "Is Sample Data",
            "description": "True if sample/demo data is used",
            "default": true
          },
          "verify_url": {
            "type": "string",
            "title": "Verify Url",
            "description": "Official verification URL"
          }
        },
        "type": "object",
        "required": [
          "status",
          "verify_url"
        ],
        "title": "RegistryInfo",
        "description": "Snapshot verification outcome for claimed registration numbers/names."
      },
      "SpeakRequest": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "strong_red_flags",
              "cannot_verify",
              "no_red_flags_found",
              "out_of_scope"
            ],
            "title": "Verdict",
            "description": "Verdict code for spoken summary note"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes",
            "description": "List of reason codes to read aloud (max 3 spoken)"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Target language (gu, hi, en)",
            "default": "en"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "verdict"
        ],
        "title": "SpeakRequest",
        "description": "Request to synthesize spoken explanation.\n\nSECURITY MANDATE:\nAccepts ONLY structured reason codes and verdict. Free-text inputs are strictly\nforbidden to ensure the backend only speaks validated, safe templated phrases."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}